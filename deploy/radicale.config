# /etc/radicale/config – Radicale 3.5.x (pip), počúva pre NPM (kliky-cal.fabrici.xyz)
[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /etc/radicale/users
htpasswd_encryption = autodetect
# iOS občas pošle meno URL-enkódované – týka sa mien s @, naše je bez neho
urldecode_username = True

[rights]
type = owner_only

[storage]
filesystem_folder = /var/lib/radicale/collections

[logging]
level = info
request_header_on_debug = False
