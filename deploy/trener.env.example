# /etc/trener/trener.env – chmod 600, vlastník trener
BOT_TOKEN=123456789:AAAA...
OWNER_CHAT_ID=5756450012
TZ_NAME=Europe/Bratislava

# Tabuľka na OMV (SMB share „share“, priečinok Kliky)
TABLE_BACKEND=smb
SMB_SERVER=192.168.1.185
SMB_SHARE=share
SMB_PATH=Kliky/kliky.xlsx
SMB_USERNAME=jakub
SMB_PASSWORD=...
TABLE_SYNC_SECONDS=120

# Pripomienky (Radicale beží v tom istom kontajneri)
CALDAV_URL=http://127.0.0.1:5232/
CALDAV_USERNAME=jakub
CALDAV_PASSWORD=...
CALDAV_LIST=Kliky
REMINDERS_SYNC_SECONDS=120

# /health a /wake (iOS Skratka po zobudení: https://kliky.fabrici.xyz/wake?token=…)
WEB_PORT=8790
WAKE_WEBHOOK_TOKEN=

# Voliteľné: kritický budík cez Home Assistant pri prvej výzve každej fázy (default vypnuté)
#HA_ALARM_WEBHOOK_URL=https://192.168.1.102:8123/api/webhook/kliky-alarm-...

# Východiskové hodnoty len pri úplne prvom štarte (potom platí tabuľka)
# Plán: ráno 2X; v pondelok, stredu a piatok aj večer 2X; nedeľa voľno.
SEED_X=8
# o koľko X narastie každý pondelok
SEED_X_STEP=1
SEED_MORNING_TIME=07:00
SEED_EVENING_TIME=19:20

STATE_DB=/var/lib/trener/trener.db
LOG_FILE=/var/log/trener/trener.log
TICK_SECONDS=30
