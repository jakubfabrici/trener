[Unit]
Description=Virtuálny tréner klikov v2 (Telegram + Apple Pripomienky + tabuľka na OMV)
After=network-online.target radicale.service
Wants=network-online.target

[Service]
Type=simple
User=trener
Group=trener
EnvironmentFile=/etc/trener/trener.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/trener/.venv/bin/trener
Restart=always
RestartSec=5
# hardening bezpečné v unprivileged LXC
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trener /var/log/trener

[Install]
WantedBy=multi-user.target
